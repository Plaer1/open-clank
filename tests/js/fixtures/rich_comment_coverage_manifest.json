      "specialCases": ["begin-end-column-sensitive", "heredoc", "percent-string", "regex"]
    },
    {
      "label": "PHP",
      "behavior": "comments",
      "fixture": "<?php\\n// line\\n# hash\\n/** doc */\\n$s = \"// not\";\\n",
      "expectRegions": 3,
