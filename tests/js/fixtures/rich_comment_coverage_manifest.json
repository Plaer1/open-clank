      "specialCases": ["heredoc", "nowdoc", "mixed-html-js-css"]
    },
    {
      "label": "Swift",
      "behavior": "comments",
      "fixture": "/// doc\\n// line\\n/* nested /* x */ */\\nlet s = \"\"\"// not\"\"\"\\n",
      "expectRegions": 3,
      "expectKinds": ["doc-line", "line", "block"],
      "specialCases": ["nested-block", "multiline-string", "raw-string", "interpolation"]
    },
    {
      "label": "Shell",
      "behavior": "comments",
      "fixture": "#!/bin/bash\\n# comment\\necho \"# not\" # tail\\n",
