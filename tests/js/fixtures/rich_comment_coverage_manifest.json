      "specialCases": ["quoted-string", "block-scalar"]
    },
    {
      "label": "TOML",
      "behavior": "comments",
      "fixture": "# comment\\nkey = \"# not\" # trailing\\n",
      "expectRegions": 2,
      "expectKinds": ["line", "line"],
      "specialCases": ["multiline-basic-string", "multiline-literal-string"]
    },
    {
      "label": "XML",
      "behavior": "comments",
      "fixture": "<!-- doc -->\\n<root attr=\"<!-- not -->\"/>\\n",
      "expectRegions": 1,
      "expectKinds": ["doc-block"],
      "specialCases": ["cdata", "declaration", "attribute-value"]
    },
    {
      "label": "HTML",
      "behavior": "comments",
      "fixture": "<!-- doc -->\\n<script>// js</script>\\n<style>/* css */</style>\\n",
      "expectRegions": 3,
      "expectKinds": ["doc-block", "line", "block"],
      "specialCases": ["nested-js-comment", "nested-css-comment", "script-style-strings"]
    },
    {
      "label": "CSS",
      "behavior": "comments",
      "fixture": "/* block */\\n.app { content: \"/* not */\"; }\\n",
      "expectRegions": 1,
      "expectKinds": ["block"],
      "specialCases": ["string-url-token"]
    },
    {
      "label": "SCSS",
      "behavior": "comments",
      "fixture": "// line\\n/* block */\\n.app { content: \"// not\"; }\\n",
      "expectRegions": 2,
