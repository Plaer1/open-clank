{
  "version": "s16-rich-source-comments-v1",
  "description": "One checked-in coverage manifest for all 30 advertised language labels. Rows are exercised through production entrypoints (documentationRegions / documentationRegionsAsync from the built editor bundle). Ordinary strings stay raw; documentation comments and Python docstrings project Markdown.",
  "rows": [
    {
      "label": "JavaScript",
      "behavior": "comments",
      "fixture": "const x = 1; // # Heading\\n/* **block** */\\nlet re = /\\\\/\\\\/ not/;",
      "expectRegions": 2,
      "expectKinds": ["line", "block"],
      "specialCases": ["strings-lookalike", "regex-lookalike", "jsdoc-block"]
    },
    {
      "label": "JavaScript JSX",
      "behavior": "comments",
      "fixture": "const el = <div>{/* jsx comment */}</div>; // line",
      "expectRegions": 2,
      "expectKinds": ["block", "line"],
      "specialCases": ["jsx-expression-comment", "jsx-text-not-comment"]
    },
    {
      "label": "TypeScript",
      "behavior": "comments",
      "fixture": "type T = { x: number }; // typed line\\n/** JSDoc */",
      "expectRegions": 2,
      "expectKinds": ["line", "doc-block"],
      "specialCases": ["typed-declarations", "jsdoc-block"]
    },
    {
      "label": "TypeScript JSX",
      "behavior": "comments",
      "fixture": "const el: JSX.Element = <span/>; /// doc line",
      "expectRegions": 1,
      "expectKinds": ["doc-line"],
      "specialCases": ["jsx-generic-lookalike", "doc-line-marker"]
    },
    {
      "label": "Python",
      "behavior": "comments-and-docstrings",
      "fixture": "\"\"\"Module **doc**\"\"\"\\ndef f():\\n    \"fn doc\"\\n    x = \"not doc\"\\n",
      "expectRegions": 2,
      "expectKinds": ["docstring", "docstring"],
      "specialCases": ["module-docstring", "function-docstring", "assigned-string-excluded"],
      "pythonCases": {
        "positive": ["triple", "single", "raw", "unicode", "parenthesized", "adjacent", "class", "async", "doc-after-comment"],
        "negative": ["bytes", "fstring", "binary", "call", "assigned", "later"]
      }
    },
    {
      "label": "Rust",
      "behavior": "comments",
      "fixture": "fn f() {\\n    //! inner\\n    /// outer\\n    /* nested /* in */ */\\n    let s = r\"// not\";\\n}",
      "expectRegions": 3,
      "expectKinds": ["doc-line", "doc-line", "block"],
      "specialCases": ["nested-block", "raw-string-lookalike", "inner-doc", "outer-doc"]
    },
    {
      "label": "Go",
      "behavior": "comments",
      "fixture": "package main\\n// line\\n/* block */\\nvar s = \"// not\"\\n",
      "expectRegions": 2,
      "expectKinds": ["line", "block"],
      "specialCases": ["raw-string-lookalike", "directive-comment-bytes"]
    },
    {
      "label": "Java",
      "behavior": "comments",
      "fixture": "class C {\\n    /** Javadoc */\\n    // line\\n    String s = \"// not\";\\n}",
      "expectRegions": 2,
      "expectKinds": ["doc-block", "line"],
      "specialCases": ["javadoc-marker-strip", "text-block-string"]
    },
    {
      "label": "Kotlin",
      "behavior": "comments",
      "fixture": "fun f() {\\n    /** kdoc */\\n    // line\\n    val s = \"\"\"// not\"\"\"\\n}",
      "expectRegions": 2,
      "expectKinds": ["doc-block", "line"],
      "specialCases": ["nested-block", "triple-string", "interpolation"]
    },
    {
      "label": "C",
      "behavior": "comments",
      "fixture": "int main() {\\n    // line\\n    /* block */\\n    char *s = \"// not\";\\n}",
      "expectRegions": 2,
      "expectKinds": ["line", "block"],
      "specialCases": ["escaped-newline-continuation", "preprocessor-boundary"]
    },
    {
      "label": "C/C++ header",
      "behavior": "comments",
      "fixture": "#pragma once\\n// line\\n/** doc */\\n",
      "expectRegions": 2,
      "expectKinds": ["line", "doc-block"],
      "specialCases": ["extension-routing", "h-vs-hpp"]
    },
    {
      "label": "C++",
      "behavior": "comments",
      "fixture": "class C {\\n    /// doc\\n    // line\\n    /* b */\\n    auto s = R\"(// not)\";\\n}",
      "expectRegions": 3,
      "expectKinds": ["doc-line", "line", "block"],
      "specialCases": ["raw-string-delimiter", "macro-comment"]
    },
    {
      "label": "C++ header",
      "behavior": "comments",
