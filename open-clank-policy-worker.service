[Unit]
Description=Open Clank owner-local project policy worker

[Service]
Type=simple
WorkingDirectory=/home/e/sauce/ai/open-clank
ExecStart=/home/e/sauce/ai/open-clank/.venv/bin/python /home/e/sauce/ai/open-clank/scripts/odysseus-policy --socket /run/user/%U/open-clank/policy.sock serve --db /home/e/sauce/ai/open-clank/data/frankenmemory.db --state-dir /home/e/.local/state/open-clank/policy
Environment=OPEN_CLANK_DATA_DIR=/home/e/sauce/ai/open-clank/data
Environment=FM_DB_PATH=/home/e/sauce/ai/open-clank/data/frankenmemory.db
Restart=on-failure
RestartSec=1
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
RestrictAddressFamilies=AF_UNIX AF_NETLINK
RuntimeDirectory=open-clank
RuntimeDirectoryMode=0700

[Install]
WantedBy=default.target
