# Source template: install under a dedicated OS account; adjust paths before use.
[Unit]
Description=Open Clank owner-local project policy worker

[Service]
Type=simple
WorkingDirectory=%h/open-clank
ExecStart=%h/open-clank/.venv/bin/python %h/open-clank/scripts/odysseus-policy --socket /run/user/%U/open-clank/policy.sock serve --db %h/open-clank/data/frankenmemory.db --state-dir %h/.local/state/open-clank/policy
Environment=OPEN_CLANK_DATA_DIR=%h/open-clank/data
Environment=FM_DB_PATH=%h/open-clank/data/frankenmemory.db
Restart=on-failure
RestartSec=1
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
RestrictAddressFamilies=AF_UNIX AF_NETLINK
RuntimeDirectory=open-clank
RuntimeDirectoryMode=0700

[Install]
WantedBy=default.target
