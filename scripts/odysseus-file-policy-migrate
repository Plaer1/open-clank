#!/usr/bin/env python3
"""Plan or explicitly apply the canonical Odysseus file-policy migration."""

from __future__ import annotations

import argparse
import json
import os
import sys
from pathlib import Path


ROOT = Path(__file__).resolve().parent.parent
if str(ROOT) not in sys.path:
    sys.path.insert(0, str(ROOT))
REPO_PYTHON = ROOT / "venv" / "bin" / "python"
if REPO_PYTHON.is_file() and Path(sys.executable).resolve() != REPO_PYTHON.resolve():
    os.execv(str(REPO_PYTHON), [str(REPO_PYTHON), str(Path(__file__).resolve()), *sys.argv[1:]])

from core.auth import AuthManager  # noqa: E402
from src.constants import APP_DB, AUTH_FILE, DATA_DIR  # noqa: E402
from src.openclank.file_policy import FilePolicyRepository  # noqa: E402
from src.openclank.file_policy_migration import (  # noqa: E402
    apply_legacy_policy_plan,
    plan_legacy_policy_import,
)


def _workspace(value: str) -> dict[str, str]:
    owner, separator, path = str(value).partition("=")
    if not separator or not owner.strip() or not path.strip():
        raise argparse.ArgumentTypeError("workspace must be OWNER=/absolute/path")
    return {
        "owner": owner.strip().lower(),
        "path": path.strip(),
        "name": Path(path.strip()).name or "Workspace",
        "legacy_key": f"cli:{owner.strip().lower()}:{path.strip()}",
    }


def main() -> int:
    parser = argparse.ArgumentParser(
        description="Dry-run the legacy roots/grants migration; --apply requires explicit acknowledgement."
    )
    parser.add_argument(
        "--registry",
        default=str(Path(DATA_DIR) / "odysseus-file-roots.json"),
        help="legacy filesystem registry JSON",
    )
    parser.add_argument("--database", default=APP_DB, help="application SQLite database")
    parser.add_argument("--auth", default=AUTH_FILE, help="auth.json containing immutable account IDs")
    parser.add_argument(
        "--workspace",
        action="append",
        type=_workspace,
        default=[],
        metavar="OWNER=/PATH",
        help="validated legacy browser workspace candidate (repeatable)",
    )
    parser.add_argument("--output", help="write the JSON report to this file")
    parser.add_argument("--apply", action="store_true", help="apply the reviewed plan transactionally")
    parser.add_argument(
        "--acknowledge-unresolved",
        action="store_true",
        help="allow --apply while unresolved legacy rows remain excluded",
    )
    args = parser.parse_args()

    auth = AuthManager(str(args.auth))
    subject_ids = {
        username: auth.account_id(username)
        for username in auth.users
        if auth.account_id(username)
    }
    admins = [
        account_id
        for username, account_id in subject_ids.items()
        if auth.is_admin(username)
    ]
    plan = plan_legacy_policy_import(
        registry_path=args.registry,
        subject_ids=subject_ids,
        admin_subject_ids=admins,
        grant_db_path=args.database,
        raw_workspaces=args.workspace,
    )
    report = {"mode": "dry-run", "plan": plan.as_dict()}
    if args.apply:
        if plan.unresolved and not args.acknowledge_unresolved:
            report["error"] = (
                "unresolved rows remain; review them and rerun with "
                "--acknowledge-unresolved to keep them excluded"
            )
            payload = json.dumps(report, indent=2, sort_keys=True) + "\n"
            if args.output:
                Path(args.output).write_text(payload, encoding="utf-8")
            sys.stdout.write(payload)
            return 2
        repository = FilePolicyRepository(args.database)
        report["mode"] = "applied"
        report["result"] = apply_legacy_policy_plan(repository, plan, create_backup=True)

    payload = json.dumps(report, indent=2, sort_keys=True) + "\n"
    if args.output:
        Path(args.output).write_text(payload, encoding="utf-8")
    sys.stdout.write(payload)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
