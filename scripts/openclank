#!/usr/bin/env python3
"""Public Open Clank command."""

from __future__ import annotations

import os
import sys
from pathlib import Path


REPO_ROOT = Path(__file__).resolve().parents[1]


def _enter_checkout_environment() -> None:
    """Run the public checkout command with its own managed Python environment."""
    current_prefix = Path(sys.prefix).resolve()
    candidates = (
        (REPO_ROOT / "venv", REPO_ROOT / "venv" / "bin" / "python"),
        (REPO_ROOT / ".venv", REPO_ROOT / ".venv" / "bin" / "python"),
        (REPO_ROOT / "venv", REPO_ROOT / "venv" / "Scripts" / "python.exe"),
        (REPO_ROOT / ".venv", REPO_ROOT / ".venv" / "Scripts" / "python.exe"),
    )
    for environment, interpreter in candidates:
        if not interpreter.is_file():
            continue
        if current_prefix == environment.resolve():
            return
        os.execv(str(interpreter), [str(interpreter), str(Path(__file__).resolve()), *sys.argv[1:]])


_enter_checkout_environment()
if str(REPO_ROOT) not in sys.path:
    sys.path.insert(0, str(REPO_ROOT))

from src.openclank.cli import main  # noqa: E402


if __name__ == "__main__":
    raise SystemExit(main())
