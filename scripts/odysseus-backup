#!/usr/bin/env python3
"""odysseus-backup — snapshot + restore of the data directory.

Backs up everything the app keeps under `data/`: the SQLite DB, the
Fernet key, JSON state files, RAG indexes, personal docs, attachments,
WhatsApp session, etc. Output is a gzip tarball — composable with cron
+ scp + s3cmd. The backup uses `sqlite3 .backup` for the DB so the
app can keep running during the snapshot.

    odysseus-backup snapshot                       # → backups/YYYY-MM-DD-HHMMSS.tar.gz
    odysseus-backup snapshot --out /mnt/nas/x.tgz
    odysseus-backup list                           # entries in backups/
    odysseus-backup restore PATH --yes --app-stopped # replace data/ from a tarball
    odysseus-backup verify PATH                    # tarball integrity check (no extract)

Restore is destructive and must run while every Open Clank process that can
hold a data-store handle is stopped. Pass both `--yes` and `--app-stopped`;
the latter is an operator assertion, not an in-app process broker.
"""

from __future__ import annotations
import sys
import os, sys
sys.path.insert(0, os.path.join(os.path.dirname(__file__), "_lib"))
from cli import quiet_logs, emit, fail, common_parser, run, REPO_ROOT as _REPO_ROOT
quiet_logs()

import argparse
import ctypes
import hashlib
import io
import json
import logging
import os
import shutil
import sqlite3
import subprocess
import sys
import tarfile
import tempfile
import unicodedata
import uuid
from datetime import datetime
from pathlib import Path, PurePosixPath

_DATA_DIR = _REPO_ROOT / "data"
_BACKUP_DIR = _REPO_ROOT / "backups"
_SQLITE_HEADER = b"SQLite format 3\x00"
_SQLITE_SIDECAR_SUFFIXES = ("-wal", "-shm", "-journal")
_KNOWN_TOP_LEVEL_SQLITE_NAMES = {
    "app.db",
    "email_cache.db",
    "frankenmemory.db",
    "mimocode.db",
    "odysseus.db",
    "openclank.db",
    "scheduled_emails.db",
}
_MANIFEST_NAME = ".openclank-backup-manifest-v1.json"
_MANIFEST_FORMAT = "open-clank-data-backup"
_MANIFEST_VERSION = 1

# Stuff inside data/ that we explicitly skip — anything we can re-derive
# from the SQLite DB + JSON state. Keeps the tarball small.
_SKIP_PATTERNS = {
    "mail-attachments",     # cached IMAP attachment extractions
    "deep_research",        # research runs are large; back up explicitly via --include-research
    "personal_uploads",     # uploaded files; usually wanted, included by default actually
}


class BackupValidationError(RuntimeError):
    """An archive or staged data tree failed a fail-closed invariant."""


def _path_present(path: Path) -> bool:
    return path.exists() or path.is_symlink()


def _is_sqlite_sidecar(path: Path | PurePosixPath | str) -> bool:
    return str(path).lower().endswith(_SQLITE_SIDECAR_SUFFIXES)


def _portable_path_key(path: PurePosixPath) -> str:
    return "/".join(
        unicodedata.normalize("NFC", part).casefold() for part in path.parts
    )


def _has_sqlite_header(path: Path) -> bool:
    with path.open("rb") as src:
        return src.read(len(_SQLITE_HEADER)) == _SQLITE_HEADER


def _as_posix_relative(path: Path | PurePosixPath | str) -> PurePosixPath:
    if isinstance(path, Path):
        return PurePosixPath(path.as_posix())
    return PurePosixPath(str(path))


def _is_known_sqlite_store(relative: Path | PurePosixPath | str) -> bool:
    rel = _as_posix_relative(relative)
    folded_parts = tuple(part.casefold() for part in rel.parts)
    if not folded_parts:
        return False
    name = folded_parts[-1]
    is_mimocode_store = (
        name == "mimocode.db"
        or (name.startswith("mimocode-") and name.endswith(".db"))
    )
    if len(folded_parts) == 1:
        return name in _KNOWN_TOP_LEVEL_SQLITE_NAMES or is_mimocode_store
    if folded_parts[0] == "backups" and name == "app.db":
        return True
    if folded_parts[:2] == ("runtime", "agent-engine"):
        return name in _KNOWN_TOP_LEVEL_SQLITE_NAMES or is_mimocode_store
    return False


def _classify_data_file(
    path: Path,
    relative: Path | PurePosixPath | str | None = None,
) -> str:
    if _has_sqlite_header(path):
        return "sqlite"
    rel = relative if relative is not None else path.name
    if _is_known_sqlite_store(rel):
        if path.stat().st_size == 0:
            return "sqlite"
        raise BackupValidationError(
            f"known SQLite store has an invalid header: {path.name!r}"
        )
    return "file"


def _sqlite_sidecar_primary(
    relative: Path | PurePosixPath | str,
) -> PurePosixPath | None:
    rel = _as_posix_relative(relative)
    folded_name = rel.name.casefold()
    for suffix in _SQLITE_SIDECAR_SUFFIXES:
        if folded_name.endswith(suffix) and len(rel.name) > len(suffix):
            return rel.with_name(rel.name[:-len(suffix)])
    return None


def _is_live_sqlite_sidecar(path: Path, relative: Path | PurePosixPath | str) -> bool:
    primary_rel = _sqlite_sidecar_primary(relative)
    if primary_rel is None:
        return False
    primary = path.with_name(primary_rel.name)
    if primary.is_file() and not primary.is_symlink():
        try:
            return _classify_data_file(primary, primary_rel) == "sqlite"
        except BackupValidationError:
            # The primary will fail the snapshot explicitly when it is visited;
            # never publish its independently live sidecar in the meantime.
            return True
    return _is_known_sqlite_store(primary_rel)


def _sqlite_readonly_uri(path: Path) -> str:
    return f"{path.resolve().as_uri()}?mode=ro"


def _remove_private_sqlite_runtime_sidecars(
    path: Path,
    *,
    label: str,
) -> None:
    """Remove SQLite runtime files created while validating a private primary."""
    failures = []
    for suffix in _SQLITE_SIDECAR_SUFFIXES:
        sidecar = Path(f"{path}{suffix}")
        try:
            sidecar.unlink(missing_ok=True)
        except OSError as exc:
            failures.append(f"{sidecar.name}: {exc}")
    if failures:
        raise BackupValidationError(
            f"could not remove SQLite validation sidecars for {label}: "
            + "; ".join(failures)
        )


def _validate_sqlite_database(path: Path, *, label: str | None = None) -> None:
    """Validate a private, coherent SQLite primary and remove runtime sidecars.

    The caller must only pass a staged standalone primary whose archived/live
    sidecars have already been rejected or consolidated. Even `mode=ro` may
    create WAL locking files beside that primary, so close the connection and
    remove only those exact runtime paths before the candidate can be hashed or
    published. The live source connection in `_sqlite_safe_copy` is separate
    and is never cleaned here.
    """
    display = label or str(path)
    conn = None
    try:
        conn = sqlite3.connect(_sqlite_readonly_uri(path), uri=True)
        quick_rows = conn.execute("PRAGMA quick_check").fetchall()
        if not quick_rows or any(row != ("ok",) for row in quick_rows):
            details = "; ".join(str(row[0]) for row in quick_rows) or "no result"
            raise BackupValidationError(
                f"SQLite quick_check failed for {display}: {details}"
            )
        foreign_key_rows = conn.execute("PRAGMA foreign_key_check").fetchall()
        if foreign_key_rows:
            raise BackupValidationError(
                f"SQLite foreign_key_check failed for {display}: "
                f"{len(foreign_key_rows)} violation(s)"
            )
    except BackupValidationError:
        raise
    except (OSError, sqlite3.Error) as exc:
        raise BackupValidationError(
            f"SQLite validation failed for {display}: {exc}"
        ) from exc
    finally:
        try:
            if conn is not None:
                conn.close()
        finally:
            _remove_private_sqlite_runtime_sidecars(path, label=display)


def _sqlite_safe_copy(src: Path, dst: Path) -> None:
    """Create a coherent SQLite snapshot or fail without a raw-copy fallback."""
    src_conn = None
    dst_conn = None
    try:
        src_conn = sqlite3.connect(_sqlite_readonly_uri(src), uri=True)
        dst_conn = sqlite3.connect(str(dst))
        src_conn.backup(dst_conn)
        dst_conn.commit()
    except (OSError, sqlite3.Error) as exc:
        raise BackupValidationError(
            f"SQLite backup failed for {src}: {exc}"
        ) from exc
    finally:
        if dst_conn is not None:
            dst_conn.close()
        if src_conn is not None:
            src_conn.close()
    try:
        label = src.relative_to(_DATA_DIR).as_posix()
    except ValueError:
        label = str(src)
    os.chmod(dst, src.stat().st_mode & 0o777)
    _validate_sqlite_database(dst, label=label)


def _sha256_file(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as src:
        for chunk in iter(lambda: src.read(1024 * 1024), b""):
            digest.update(chunk)
    return digest.hexdigest()


def _manifest_bytes(files: dict[str, dict[str, object]]) -> bytes:
    return json.dumps(
        {
            "format": _MANIFEST_FORMAT,
            "version": _MANIFEST_VERSION,
            "files": files,
        },
        ensure_ascii=False,
        separators=(",", ":"),
        sort_keys=True,
    ).encode("utf-8")


def _reject_output_inside_data(out_path: Path) -> None:
    try:
        resolved = out_path.resolve()
        data_root = _DATA_DIR.resolve()
        resolved.relative_to(data_root)
    except ValueError:
        return
    fail("backup output path must be outside data/")


def _snapshot_payload_source(source: Path, relative: Path) -> Path | None:
    """Return a safe regular-file source, materializing internal symlinks.

    New archives contain regular files only.  Silently omitting a symlink is
    unsafe, though: a database or other durable payload reached through an
    internal compatibility link would disappear from an apparently successful
    backup.  Internal file links are therefore dereferenced into the private
    stage, while broken, external, directory, and special-file links fail the
    snapshot closed.  Ordinary directories remain traversal-only entries.
    """

    if source.is_symlink():
        try:
            resolved = source.resolve(strict=True)
            resolved.relative_to(_DATA_DIR.resolve())
        except (OSError, RuntimeError, ValueError):
            raise BackupValidationError(
                f"data symlink is broken or leaves data/: {relative.as_posix()!r}"
            ) from None
        if not resolved.is_file() or resolved.is_symlink():
            raise BackupValidationError(
                f"data symlink does not resolve to a regular file: "
                f"{relative.as_posix()!r}"
            )
        return resolved
    if source.is_file():
        return source
    if source.is_dir():
        return None
    raise BackupValidationError(
        f"data contains an unsupported special file: {relative.as_posix()!r}"
    )


def cmd_snapshot(args):
    """Write a tar.gz of the entire data/ directory.

    SQLite databases are dumped via .backup() into a temp file before
    being added to the tar, so a running web app can't corrupt the
    snapshot. Everything else is copied as-is."""
    if not _DATA_DIR.is_dir():
        fail(f"no data dir at {_DATA_DIR}")
    _BACKUP_DIR.mkdir(parents=True, exist_ok=True)
    out_path = Path(args.out) if args.out else (
        _BACKUP_DIR / f"odysseus-backup-{datetime.now().strftime('%Y%m%d-%H%M%S')}.tar.gz"
    )
    _reject_output_inside_data(out_path)
    out_path.parent.mkdir(parents=True, exist_ok=True)

    files_added = 0
    total_bytes = 0

    with tempfile.TemporaryDirectory() as tmp_str:
        tmp = Path(tmp_str)
        staged_data = tmp / "data"
        staged_data.mkdir()
        manifest_files: dict[str, dict[str, object]] = {}

        try:
            # Stage every included payload first. Confirmed SQLite files use the
            # online backup API; ordinary files are copied to keep the manifest
            # and archive bytes stable even if the live file changes later.
            for source in sorted(_DATA_DIR.rglob("*")):
                rel = source.relative_to(_DATA_DIR)
                if not args.include_research and "deep_research" in rel.parts:
                    continue
                if not args.include_attachments and "mail-attachments" in rel.parts:
                    continue
                payload_source = _snapshot_payload_source(source, rel)
                if payload_source is None:
                    continue
                if _is_live_sqlite_sidecar(source, rel):
                    continue

                staged = staged_data / rel
                staged.parent.mkdir(parents=True, exist_ok=True)
                kind = _classify_data_file(payload_source, rel)
                if kind == "sqlite":
                    _sqlite_safe_copy(payload_source, staged)
                else:
                    shutil.copy2(payload_source, staged)

                size = staged.stat().st_size
                manifest_files[rel.as_posix()] = {
                    "kind": kind,
                    "sha256": _sha256_file(staged),
                    "size": size,
                }
                files_added += 1
                total_bytes += size

            manifest_payload = _manifest_bytes(manifest_files)
            fd, candidate_name = tempfile.mkstemp(
                prefix=f".{out_path.name}.",
                suffix=".tmp",
                dir=str(out_path.parent),
            )
            os.close(fd)
            candidate_path = Path(candidate_name)
            try:
                with tarfile.open(candidate_path, "w:gz") as tar:
                    tar.add(staged_data, arcname="data", recursive=False)
                    for rel_name in sorted(manifest_files):
                        tar.add(
                            staged_data / Path(rel_name),
                            arcname=f"data/{rel_name}",
                            recursive=False,
                        )
                    manifest_info = tarfile.TarInfo(_MANIFEST_NAME)
                    manifest_info.size = len(manifest_payload)
                    manifest_info.mode = 0o600
                    tar.addfile(manifest_info, io.BytesIO(manifest_payload))

                # Re-open, fully extract, hash, and validate the candidate before
                # the atomic replace makes it visible at the requested path.
                with tempfile.TemporaryDirectory() as verify_tmp:
                    _stage_archive(candidate_path, Path(verify_tmp))
                with candidate_path.open("rb") as candidate_file:
                    os.fsync(candidate_file.fileno())
                os.replace(candidate_path, out_path)
            finally:
                candidate_path.unlink(missing_ok=True)
        except (
            BackupValidationError,
            EOFError,
            OSError,
            sqlite3.Error,
            tarfile.TarError,
        ) as exc:
            fail(f"snapshot failed: {exc}")

    emit({
        "ok": True,
        "path": str(out_path),
        "files": files_added,
        "uncompressed_bytes": total_bytes,
        "compressed_bytes": out_path.stat().st_size,
        "ratio": round(out_path.stat().st_size / max(total_bytes, 1), 4),
        "included_research": bool(args.include_research),
        "included_attachments": bool(args.include_attachments),
    }, args)


def cmd_list(args):
    """List entries in `backups/`. Most recent first."""
    if not _BACKUP_DIR.is_dir():
        emit([], args)
        return
    entries = []
    for p in _BACKUP_DIR.iterdir():
        entry = _backup_entry(p)
        if entry is not None:
            entries.append(entry)
    entries.sort(key=lambda entry: entry["_mtime"], reverse=True)
    for entry in entries:
        entry.pop("_mtime", None)
    emit(entries, args)


def _backup_entry(p):
    try:
        if not p.is_file():
            return None
        st = p.stat()
    except OSError:
        return None
    return {
        "path": str(p),
        "name": p.name,
        "bytes": st.st_size,
        "modified": datetime.fromtimestamp(st.st_mtime).isoformat(),
        "_mtime": st.st_mtime,
    }


def cmd_verify(args):
    """Fully stage and validate a tarball without publishing it."""
    path = Path(args.path)
    if not path.exists():
        fail(f"no file at {path}")
    try:
        with tempfile.TemporaryDirectory(prefix="openclank-backup-verify-") as tmp_str:
            result = _stage_archive(path, Path(tmp_str))
    except (
        BackupValidationError,
        EOFError,
        OSError,
        sqlite3.Error,
        tarfile.TarError,
    ) as exc:
        fail(f"tarball is invalid: {exc}")
    emit({
        "ok": True,
        "path": str(path),
        "members": result["members"],
        "first": result["first"],
        "last": result["last"],
        "format_version": result["format_version"],
        "sqlite_files": result["sqlite_files"],
        "consolidated_legacy_sidecars": result["consolidated_legacy_sidecars"],
    }, args)


def _validate_restore_members(members):
    """Reject unsafe, ambiguous, or colliding archive member layouts."""
    validated = []
    entry_types: dict[str, str] = {}
    portable_entry_types: dict[str, str] = {}
    for m in members:
        if "\\" in m.name:
            raise BackupValidationError(
                f"refusing tarball with non-portable path separator: {m.name!r}"
            )
        rel = PurePosixPath(m.name)
        if rel.is_absolute() or ".." in rel.parts:
            raise BackupValidationError(
                f"refusing tarball with absolute/parent path: {m.name!r}"
            )
        if not rel.parts:
            raise BackupValidationError("refusing tarball with an empty member name")
        canonical = rel.as_posix()
        if canonical == _MANIFEST_NAME:
            if not m.isfile():
                raise BackupValidationError("backup manifest must be a regular file")
        elif rel.parts[0] != "data":
            raise BackupValidationError(
                f"refusing tarball with entry outside data/: {m.name!r}"
            )
        if m.issym() or m.islnk():
            raise BackupValidationError(
                f"refusing tarball with link entry: {m.name!r}"
            )
        if not (m.isdir() or m.isfile()):
            raise BackupValidationError(
                f"refusing tarball with special file entry: {m.name!r}"
            )
        if canonical == "data" and not m.isdir():
            raise BackupValidationError("top-level data member must be a directory")
        if canonical in entry_types:
            raise BackupValidationError(
                f"refusing tarball with duplicate member: {canonical!r}"
            )
        entry_type = "dir" if m.isdir() else "file"
        portable_key = _portable_path_key(rel)
        if portable_key in portable_entry_types:
            raise BackupValidationError(
                f"refusing tarball with portable-path collision: {canonical!r}"
            )
        entry_types[canonical] = entry_type
        portable_entry_types[portable_key] = entry_type
        validated.append((m, canonical))

    for canonical in entry_types:
        if canonical == _MANIFEST_NAME:
            continue
        parts = PurePosixPath(canonical).parts
        for index in range(1, len(parts)):
            parent = PurePosixPath(*parts[:index]).as_posix()
            if entry_types.get(parent) == "file":
                raise BackupValidationError(
                    f"refusing tarball with file/directory collision at {parent!r}"
                )
            portable_parent = _portable_path_key(PurePosixPath(*parts[:index]))
            if portable_entry_types.get(portable_parent) == "file":
                raise BackupValidationError(
                    f"refusing tarball with portable file/directory collision "
                    f"at {parent!r}"
                )
    return validated


def _unique_json_object(pairs):
    result = {}
    for key, value in pairs:
        if key in result:
            raise BackupValidationError(f"duplicate manifest key: {key!r}")
        result[key] = value
    return result


def _read_archive_manifest(tar, validated):
    manifest_member = next(
        (member for member, canonical in validated if canonical == _MANIFEST_NAME),
        None,
    )
    if manifest_member is None:
        return None
    if manifest_member.size > 16 * 1024 * 1024:
        raise BackupValidationError("backup manifest is unreasonably large")
    src = tar.extractfile(manifest_member)
    if src is None:
        raise BackupValidationError("could not read backup manifest")
    try:
        with src:
            payload = src.read()
        manifest = json.loads(
            payload.decode("utf-8"), object_pairs_hook=_unique_json_object
        )
    except (UnicodeDecodeError, json.JSONDecodeError) as exc:
        raise BackupValidationError(f"backup manifest is invalid JSON: {exc}") from exc

    if not isinstance(manifest, dict):
        raise BackupValidationError("backup manifest must be an object")
    if manifest.get("format") != _MANIFEST_FORMAT:
        raise BackupValidationError("backup manifest format is unsupported")
    manifest_version = manifest.get("version")
    if (
        isinstance(manifest_version, bool)
        or not isinstance(manifest_version, int)
        or manifest_version != _MANIFEST_VERSION
    ):
        raise BackupValidationError(
            f"backup manifest version is unsupported: {manifest_version!r}"
        )
    files = manifest.get("files")
    if not isinstance(files, dict):
        raise BackupValidationError("backup manifest files must be an object")

    normalized_files: dict[str, dict[str, object]] = {}
    portable_names = set()
    for name, metadata in files.items():
        if not isinstance(name, str) or not name:
            raise BackupValidationError("backup manifest contains an invalid path")
        if "\\" in name:
            raise BackupValidationError(
                f"backup manifest path is not portable: {name!r}"
            )
        rel = PurePosixPath(name)
        if rel.is_absolute() or ".." in rel.parts or rel.as_posix() != name:
            raise BackupValidationError(f"backup manifest path is unsafe: {name!r}")
        portable_name = _portable_path_key(rel)
        if portable_name in portable_names:
            raise BackupValidationError(
                f"backup manifest has a portable-path collision: {name!r}"
            )
        portable_names.add(portable_name)
        if not isinstance(metadata, dict):
            raise BackupValidationError(
                f"backup manifest metadata is invalid for {name!r}"
            )
        kind = metadata.get("kind")
        size = metadata.get("size")
        digest = metadata.get("sha256")
        if kind not in {"file", "sqlite"}:
            raise BackupValidationError(f"backup manifest kind is invalid for {name!r}")
        if isinstance(size, bool) or not isinstance(size, int) or size < 0:
            raise BackupValidationError(f"backup manifest size is invalid for {name!r}")
        if (
            not isinstance(digest, str)
            or len(digest) != 64
            or any(ch not in "0123456789abcdef" for ch in digest)
        ):
            raise BackupValidationError(
                f"backup manifest digest is invalid for {name!r}"
            )
        normalized_files[name] = {
            "kind": kind,
            "size": size,
            "sha256": digest,
        }
    return normalized_files


def _extract_restore_members(tar, members, root: Path) -> None:
    """Extract regular payloads into a private, validated staging root."""
    for m, canonical in _validate_restore_members(members):
        if canonical == _MANIFEST_NAME:
            continue
        rel = PurePosixPath(canonical)
        target = root.joinpath(*rel.parts)
        if m.isdir():
            target.mkdir(parents=True, exist_ok=True)
            continue
        target.parent.mkdir(parents=True, exist_ok=True)
        src = tar.extractfile(m)
        if src is None:
            raise BackupValidationError(f"extract failed: could not read {m.name!r}")
        with src, open(target, "wb") as dst:
            shutil.copyfileobj(src, dst)
        os.chmod(target, m.mode & 0o777)


def _find_staged_sqlite_sidecars(
    data_dir: Path,
) -> dict[PurePosixPath, list[Path]]:
    groups: dict[PurePosixPath, list[Path]] = {}
    for sidecar in sorted(data_dir.rglob("*")):
        if not sidecar.is_file() or sidecar.is_symlink():
            continue
        sidecar_rel = PurePosixPath(sidecar.relative_to(data_dir).as_posix())
        primary_rel = _sqlite_sidecar_primary(sidecar_rel)
        if primary_rel is None:
            continue
        primary = data_dir.joinpath(*primary_rel.parts)
        if primary.is_file() and not primary.is_symlink():
            if _classify_data_file(primary, primary_rel) == "sqlite":
                groups.setdefault(primary_rel, []).append(sidecar)
        elif _is_known_sqlite_store(primary_rel):
            raise BackupValidationError(
                f"archive contains an orphan SQLite sidecar for "
                f"{primary_rel.as_posix()!r}"
            )
    return groups


def _consolidate_legacy_sqlite_sidecars(
    data_dir: Path,
    groups: dict[PurePosixPath, list[Path]],
) -> int:
    consolidated_count = 0
    for primary_rel, sidecars in sorted(groups.items(), key=lambda item: str(item[0])):
        primary = data_dir.joinpath(*primary_rel.parts)
        candidate = primary.with_name(
            f".{primary.name}.consolidated-{uuid.uuid4().hex}.db"
        )
        src_conn = None
        dst_conn = None
        try:
            try:
                # This is an isolated restore candidate, so opening read/write
                # is intentional: SQLite may need to recover a hot rollback
                # journal before backup folds committed state into one primary.
                src_conn = sqlite3.connect(str(primary), timeout=30)
                dst_conn = sqlite3.connect(str(candidate))
                src_conn.backup(dst_conn)
                dst_conn.commit()
            except (OSError, sqlite3.Error) as exc:
                raise BackupValidationError(
                    f"could not consolidate legacy SQLite sidecars for "
                    f"{primary_rel.as_posix()!r}: {exc}"
                ) from exc
            finally:
                if dst_conn is not None:
                    dst_conn.close()
                if src_conn is not None:
                    src_conn.close()
            os.chmod(candidate, primary.stat().st_mode & 0o777)
            _validate_sqlite_database(candidate, label=primary_rel.as_posix())
            os.replace(candidate, primary)
        finally:
            candidate.unlink(missing_ok=True)
        for sidecar in sidecars:
            sidecar.unlink(missing_ok=True)
            consolidated_count += 1
    return consolidated_count


def _validate_data_tree(data_dir: Path) -> dict[str, dict[str, object]]:
    if not data_dir.is_dir() or data_dir.is_symlink():
        raise BackupValidationError("archive does not contain a regular data/ directory")
    files: dict[str, dict[str, object]] = {}
    for path in sorted(data_dir.rglob("*")):
        if path.is_symlink():
            raise BackupValidationError(
                f"staged data contains a link: {path.relative_to(data_dir)!s}"
            )
        if not path.is_file():
            continue
        rel = path.relative_to(data_dir)
        kind = _classify_data_file(path, rel)
        if kind == "sqlite":
            _validate_sqlite_database(path, label=rel.as_posix())
        files[rel.as_posix()] = {
            "kind": kind,
            "size": path.stat().st_size,
            "sha256": _sha256_file(path),
        }
    return files


def _validate_manifest_files(
    expected: dict[str, dict[str, object]] | None,
    actual: dict[str, dict[str, object]],
) -> None:
    if expected is None:
        return
    missing = sorted(set(expected) - set(actual))
    unexpected = sorted(set(actual) - set(expected))
    if missing or unexpected:
        details = []
        if missing:
            details.append(f"missing={missing[:5]!r}")
        if unexpected:
            details.append(f"unexpected={unexpected[:5]!r}")
        raise BackupValidationError(
            "backup payload does not match manifest: " + ", ".join(details)
        )
    for name, metadata in expected.items():
        if actual[name] != metadata:
            raise BackupValidationError(
                f"backup payload does not match manifest metadata for {name!r}"
            )


def _stage_archive(path: Path, staging_root: Path) -> dict[str, object]:
    if _path_present(staging_root / "data"):
        raise BackupValidationError("restore staging root is not empty")
    with tarfile.open(path, "r:gz") as tar:
        members = tar.getmembers()
        validated = _validate_restore_members(members)
        manifest_files = _read_archive_manifest(tar, validated)
        if manifest_files is not None:
            undeclared_directories = [
                canonical
                for member, canonical in validated
                if member.isdir() and canonical != "data"
            ]
            if undeclared_directories:
                raise BackupValidationError(
                    "manifested backups must not contain undeclared directories: "
                    f"{undeclared_directories[:5]!r}"
                )
        _extract_restore_members(tar, members, staging_root)

    data_dir = staging_root / "data"
    sidecar_groups = _find_staged_sqlite_sidecars(data_dir)
    if manifest_files is not None and sidecar_groups:
        raise BackupValidationError(
            "manifested backups must not contain live SQLite sidecars"
        )
    consolidated_sidecars = (
        _consolidate_legacy_sqlite_sidecars(data_dir, sidecar_groups)
        if manifest_files is None
        else 0
    )
    actual_files = _validate_data_tree(data_dir)
    _validate_manifest_files(manifest_files, actual_files)
    return {
        "members": len(members),
        "first": members[0].name if members else None,
        "last": members[-1].name if members else None,
        "format_version": _MANIFEST_VERSION if manifest_files is not None else None,
        "sqlite_files": sum(
            1 for metadata in actual_files.values() if metadata["kind"] == "sqlite"
        ),
        "consolidated_legacy_sidecars": consolidated_sidecars,
    }


def _unique_restore_stash_path() -> Path:
    timestamp = datetime.now().strftime("%Y%m%d-%H%M%S")
    for _ in range(20):
        candidate = _REPO_ROOT / (
            f"data.before-restore-{timestamp}-{uuid.uuid4().hex[:8]}"
        )
        if not _path_present(candidate):
            return candidate
    raise BackupValidationError("could not allocate a unique restore stash path")


def _rename_path(source: Path, destination: Path) -> None:
    os.rename(source, destination)


def _exchange_paths(first: Path, second: Path) -> None:
    """Atomically swap two existing paths without an absent-data interval."""
    if os.name != "posix":
        raise BackupValidationError(
            "atomic restore exchange is unavailable on this operating system"
        )
    libc = ctypes.CDLL(None, use_errno=True)
    first_bytes = os.fsencode(first)
    second_bytes = os.fsencode(second)
    exchange_flag = 0x00000002

    if sys.platform == "darwin":
        rename_exchange = getattr(libc, "renamex_np", None)
        if rename_exchange is None:
            raise BackupValidationError("renamex_np is unavailable for atomic restore")
        rename_exchange.argtypes = [ctypes.c_char_p, ctypes.c_char_p, ctypes.c_uint]
        rename_exchange.restype = ctypes.c_int
        result = rename_exchange(first_bytes, second_bytes, exchange_flag)
    elif sys.platform.startswith("linux"):
        rename_exchange = getattr(libc, "renameat2", None)
        if rename_exchange is None:
            raise BackupValidationError("renameat2 is unavailable for atomic restore")
        rename_exchange.argtypes = [
            ctypes.c_int,
            ctypes.c_char_p,
            ctypes.c_int,
            ctypes.c_char_p,
            ctypes.c_uint,
        ]
        rename_exchange.restype = ctypes.c_int
        at_fdcwd = -100
        result = rename_exchange(
            at_fdcwd,
            first_bytes,
            at_fdcwd,
            second_bytes,
            exchange_flag,
        )
    else:
        raise BackupValidationError(
            f"atomic restore exchange is unsupported on {sys.platform}"
        )

    if result != 0:
        error_number = ctypes.get_errno()
        raise OSError(
            error_number,
            f"atomic restore exchange failed: {os.strerror(error_number)}",
        )


def _path_identity(path: Path) -> tuple[int, int] | None:
    try:
        status = path.lstat()
    except FileNotFoundError:
        return None
    return status.st_dev, status.st_ino


def _unique_failed_restore_path() -> Path:
    timestamp = datetime.now().strftime("%Y%m%d-%H%M%S")
    for _ in range(20):
        candidate = _REPO_ROOT / (
            f"data.failed-restore-{timestamp}-{uuid.uuid4().hex[:8]}"
        )
        if not _path_present(candidate):
            return candidate
    raise BackupValidationError("could not allocate a failed-restore quarantine path")


def _quarantine_failed_tree(path: Path) -> Path:
    quarantine = _unique_failed_restore_path()
    _rename_path(path, quarantine)
    return quarantine


def _path_with_identity(
    identity: tuple[int, int],
    *paths: Path,
) -> Path | None:
    for path in paths:
        if _path_identity(path) == identity:
            return path
    return None


def _retry_prior_tree_restore(
    *,
    old_identity: tuple[int, int],
    candidate_identity: tuple[int, int],
    candidate: Path,
    stash: Path,
    rollback_errors: list[str],
    quarantined: list[Path],
) -> None:
    """Make one final identity-driven rollback attempt after a helper failed."""
    if _path_identity(_DATA_DIR) == old_identity:
        return
    old_path = _path_with_identity(old_identity, candidate, stash)
    if old_path is None:
        rollback_errors.append(
            "could not locate the exact prior data tree during final rollback"
        )
        return

    current_identity = _path_identity(_DATA_DIR)
    if current_identity == candidate_identity:
        try:
            quarantined.append(_quarantine_failed_tree(_DATA_DIR))
        except BaseException as quarantine_exc:
            rollback_errors.append(
                f"final failed-tree quarantine attempt failed: {quarantine_exc}"
            )
        current_identity = _path_identity(_DATA_DIR)

    if current_identity is None and _path_identity(old_path) == old_identity:
        try:
            _rename_path(old_path, _DATA_DIR)
        except BaseException as restore_exc:
            rollback_errors.append(
                f"final prior-tree restore attempt failed: {restore_exc}"
            )
    elif current_identity not in {None, old_identity}:
        rollback_errors.append(
            "refusing to replace an unexpected data/ tree during rollback"
        )

    if _path_identity(_DATA_DIR) != old_identity:
        retained = _path_with_identity(old_identity, candidate, stash)
        if retained is not None:
            rollback_errors.append(f"exact prior tree retained at {retained}")


def _raise_restore_publication_failure(
    exc: BaseException,
    *,
    rollback_errors: list[str],
    quarantined: list[Path],
) -> None:
    quarantine_detail = (
        "; failed/new tree retained at " + ", ".join(str(path) for path in quarantined)
        if quarantined
        else ""
    )
    if rollback_errors:
        raise BackupValidationError(
            f"restore publication failed: {exc}; rollback failed: "
            f"{' | '.join(rollback_errors)}{quarantine_detail}"
        ) from exc
    if isinstance(exc, (KeyboardInterrupt, SystemExit)):
        raise exc
    raise BackupValidationError(
        f"restore publication failed; prior data state restored: "
        f"{exc}{quarantine_detail}"
    ) from exc


def _publish_restore_candidate(candidate: Path) -> Path | None:
    had_live_data = _path_present(_DATA_DIR)
    candidate_identity = _path_identity(candidate)
    if candidate_identity is None:
        raise BackupValidationError("restore candidate disappeared before publication")

    if not had_live_data:
        quarantined: list[Path] = []
        rollback_errors: list[str] = []
        try:
            _rename_path(candidate, _DATA_DIR)
            if _path_identity(_DATA_DIR) != candidate_identity:
                raise BackupValidationError(
                    "restore publication produced an unexpected data/ identity"
                )
            _validate_data_tree(_DATA_DIR)
            if _path_identity(_DATA_DIR) != candidate_identity:
                raise BackupValidationError(
                    "restored data/ identity changed during validation"
                )
            return None
        except BaseException as exc:
            current_identity = _path_identity(_DATA_DIR)
            if current_identity == candidate_identity:
                try:
                    quarantined.append(_quarantine_failed_tree(_DATA_DIR))
                except BaseException as rollback_exc:
                    rollback_errors.append(
                        f"could not quarantine failed candidate: {rollback_exc}"
                    )
            elif current_identity is not None:
                rollback_errors.append(
                    "refusing to quarantine an unexpected data/ tree"
                )
            if _path_present(_DATA_DIR):
                rollback_errors.append("data/ should be absent but is still present")
            _raise_restore_publication_failure(
                exc,
                rollback_errors=rollback_errors,
                quarantined=quarantined,
            )

    old_identity = _path_identity(_DATA_DIR)
    if old_identity is None:
        raise BackupValidationError("prior data disappeared before atomic exchange")
    stash = _unique_restore_stash_path()
    quarantined = []
    rollback_errors = []
    try:
        _exchange_paths(_DATA_DIR, candidate)
        if (
            _path_identity(_DATA_DIR) != candidate_identity
            or _path_identity(candidate) != old_identity
        ):
            raise BackupValidationError(
                "atomic restore exchange returned an unexpected path identity"
            )
        _validate_data_tree(_DATA_DIR)
        if _path_identity(_DATA_DIR) != candidate_identity:
            raise BackupValidationError(
                "restored data/ identity changed during validation"
            )
        _rename_path(candidate, stash)
        if (
            _path_identity(stash) != old_identity
            or _path_identity(_DATA_DIR) != candidate_identity
        ):
            raise BackupValidationError(
                "restore identities changed while preserving the prior tree"
            )
        return stash
    except BaseException as exc:
        if _path_identity(_DATA_DIR) != old_identity:
            old_path = None
            if _path_identity(candidate) == old_identity:
                old_path = candidate
            elif _path_identity(stash) == old_identity:
                old_path = stash

            if old_path is None:
                rollback_errors.append(
                    "could not locate the exact prior data tree after publication failure"
                )
            else:
                try:
                    if _path_present(_DATA_DIR):
                        try:
                            _exchange_paths(_DATA_DIR, old_path)
                        except BaseException as exchange_exc:
                            if _path_identity(_DATA_DIR) != old_identity:
                                current_identity = _path_identity(_DATA_DIR)
                                if current_identity == candidate_identity:
                                    quarantined.append(
                                        _quarantine_failed_tree(_DATA_DIR)
                                    )
                                    _rename_path(old_path, _DATA_DIR)
                                elif current_identity is None:
                                    _rename_path(old_path, _DATA_DIR)
                                else:
                                    raise BackupValidationError(
                                        "refusing to replace an unexpected data/ "
                                        "tree during rollback"
                                    )
                            elif not isinstance(
                                exchange_exc, (KeyboardInterrupt, SystemExit)
                            ):
                                # The exchange completed but its wrapper raised;
                                # identity is the authority, so rollback succeeded.
                                pass
                        if _path_identity(_DATA_DIR) == old_identity:
                            if _path_identity(old_path) == candidate_identity:
                                quarantined.append(
                                    _quarantine_failed_tree(old_path)
                                )
                    else:
                        _rename_path(old_path, _DATA_DIR)
                except BaseException as rollback_exc:
                    rollback_errors.append(
                        f"could not restore prior data tree: {rollback_exc}"
                    )

        _retry_prior_tree_restore(
            old_identity=old_identity,
            candidate_identity=candidate_identity,
            candidate=candidate,
            stash=stash,
            rollback_errors=rollback_errors,
            quarantined=quarantined,
        )
        if _path_identity(_DATA_DIR) != old_identity:
            rollback_errors.append("data/ does not contain the exact prior tree")
        _raise_restore_publication_failure(
            exc,
            rollback_errors=rollback_errors,
            quarantined=quarantined,
        )


def cmd_restore(args):
    """Replace `data/` from a tarball after explicit stopped-app assertion."""
    path = Path(args.path)
    if not path.exists():
        fail(f"no file at {path}")
    if not args.yes:
        fail("restore is destructive — pass --yes to confirm overwriting data/")
    if not getattr(args, "app_stopped", False):
        fail(
            "restore requires every Open Clank data writer to be stopped — "
            "stop the app, then pass --app-stopped"
        )
    stash = None
    prior_identity = _path_identity(_DATA_DIR)
    staging_root = Path(tempfile.mkdtemp(
        prefix=f".{_REPO_ROOT.name}-restore-",
        dir=str(_REPO_ROOT.parent),
    ))
    retain_staging = False
    try:
        _stage_archive(path, staging_root)
        stash = _publish_restore_candidate(staging_root / "data")
    except (
        BackupValidationError,
        EOFError,
        OSError,
        sqlite3.Error,
        tarfile.TarError,
    ) as exc:
        retained_prior = (
            prior_identity is not None
            and _path_identity(_DATA_DIR) != prior_identity
            and _path_identity(staging_root / "data") == prior_identity
        )
        retain_staging = retained_prior
        retained_detail = (
            f"; exact prior tree retained at {staging_root / 'data'}"
            if retained_prior
            else ""
        )
        fail(f"restore failed: {exc}{retained_detail}")
    finally:
        retained_prior = (
            prior_identity is not None
            and _path_identity(_DATA_DIR) != prior_identity
            and _path_identity(staging_root / "data") == prior_identity
        )
        retain_staging = retain_staging or retained_prior
        if not retain_staging and _path_present(staging_root):
            shutil.rmtree(staging_root)
    emit({
        "ok": True,
        "restored_from": str(path),
        "previous_data_stashed_at": str(stash) if stash else None,
    }, args)


def _build_parser():
    common = argparse.ArgumentParser(add_help=False)
    common.add_argument("--pretty", action="store_true")
    p = argparse.ArgumentParser(prog="odysseus-backup", parents=[common])
    sub = p.add_subparsers(dest="cmd", required=True)

    ps = sub.add_parser("snapshot", parents=[common])
    ps.add_argument("--out", help="output path (default: backups/<timestamp>.tar.gz)")
    ps.add_argument("--include-research", action="store_true",
                    help="include data/deep_research/ (skipped by default; large)")
    ps.add_argument("--include-attachments", action="store_true",
                    help="include data/mail-attachments/ (skipped by default; re-derivable)")
    ps.set_defaults(func=cmd_snapshot)

    pl = sub.add_parser("list", parents=[common])
    pl.set_defaults(func=cmd_list)

    pv = sub.add_parser("verify", parents=[common])
    pv.add_argument("path")
    pv.set_defaults(func=cmd_verify)

    pr = sub.add_parser("restore", parents=[common])
    pr.add_argument("path")
    pr.add_argument("--yes", action="store_true",
                    help="confirm overwriting current data/")
    pr.add_argument(
        "--app-stopped",
        action="store_true",
        help="assert all Open Clank processes that can write data/ are stopped",
    )
    pr.set_defaults(func=cmd_restore)

    return p


if __name__ == "__main__":
    sys.exit(run(_build_parser()))
