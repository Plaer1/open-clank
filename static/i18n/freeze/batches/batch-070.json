    {
      "key": "treehouse.lesson.house-making.lore-restore.body",
      "source": "Make a change to a practice document and record a checkpoint. Change it again. From the document's history, restore the retained version.\n\n**Observable result:** the restore commits and the resulting content hash matches the retained version. A digest-only or observed-after claim is not a restore receipt.",
      "placeholders": [],
      "kind": "structured-prose",
      "status": "live",
      "locations": [
        "src/openclank/treehouse_field_guide.py:1010"
      ],
      "context": "body",
      "complexity": "prose"
    },
    {
      "key": "treehouse.lesson.house-making.lore-restore.explanation",
      "source": "Lore retains versions of your work with the receipts needed to restore them. A restore commits a real change: the retained version's content is written back, and the result is confirmed against that version's hash. The restore is itself recorded, so you can go forward again.",
      "placeholders": [],
      "kind": "structured-prose",
      "status": "live",
      "locations": [
        "src/openclank/treehouse_field_guide.py:1010"
      ],
      "context": "explanation",
      "complexity": "prose"
