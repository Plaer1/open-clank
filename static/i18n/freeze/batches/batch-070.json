    {
      "key": "treehouse.lesson.house-making.imps-layers.body",
      "source": "Open an image from [Files](clank://files) in Imps. Add a second editable layer. Save the project and reopen it.\n\n**Observable result:** the project reopens with the same project revision and the same layer identities. To undo the save, restore from the project's history and the preimage replays.",
      "placeholders": [],
      "kind": "structured-prose",
      "status": "live",
      "locations": [
        "src/openclank/treehouse_field_guide.py:944"
      ],
      "context": "body",
