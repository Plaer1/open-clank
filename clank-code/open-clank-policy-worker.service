# Source template: install under a dedicated OS account; adjust paths before use.
[Unit]
Description=Open Clank owner-local project policy worker

[Service]
Type=simple
WorkingDirectory=%h/open-clank/clank-code
ExecStart=/usr/bin/python3 -I src/source_layout.py run scripts/odysseus-policy --socket /run/user/%U/open-clank/policy.sock serve --state-dir %h/.local/state/open-clank/policy
Restart=on-failure
RestartSec=1
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
RestrictAddressFamilies=AF_UNIX AF_NETLINK
RuntimeDirectory=open-clank
RuntimeDirectoryMode=0700

[Install]
WantedBy=default.target
