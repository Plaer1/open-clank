#!/usr/bin/env python3
"""Public Open Clank command."""

from __future__ import annotations

import os
import sys
from pathlib import Path


REPO_ROOT = Path(__file__).resolve().parents[1]


sys.path.insert(0, str(REPO_ROOT))
from src.source_layout import environment_path


def _enter_checkout_environment() -> None:
    """Run the public checkout command with its own managed Python environment."""
    current_prefix = Path(sys.prefix).resolve()
    for name in ("venv", ".venv"):
        environment = environment_path(name, REPO_ROOT)
        interpreter = environment / ("Scripts/python.exe" if os.name == "nt" else "bin/python")
        if not interpreter.is_file():
            continue
        if current_prefix == environment.resolve():
            return
        os.execv(str(interpreter), [str(interpreter), str(Path(__file__).resolve()), *sys.argv[1:]])


_enter_checkout_environment()

from src.openclank.cli import main  # noqa: E402


if __name__ == "__main__":
    raise SystemExit(main())
