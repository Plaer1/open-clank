  "grammar": {
    "composition": "Readable planes, firm outlines, shallow elevation, attached headers and restrained accent bands.",
    "geometry": "Honor selected theme hardness/radius; page to section to focused control.",
    "typography": "Use selected theme typography; built-in fallback: Liga Comic Mono, Fira Code, monospace. Logo lettering is separate.",
    "motion": "Do not copy app background animation loops; respect output reduced-motion preference.",
    "provenance": "Capture selected theme identity, sanitized resolved appearance, standard ID/version/hash and exact local asset hashes."
  },
