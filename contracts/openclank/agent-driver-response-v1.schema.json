{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openclank.dev/contracts/agent-driver-response-v1.schema.json",
  "title": "Open Clank direct agent driver response v1",
  "type": "object",
  "required": ["schema_version", "request_id", "ok"],
  "properties": {
    "schema_version": {"const": 1},
    "request_id": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
    "ok": {"type": "boolean"},
    "event": {"type": "string", "enum": ["hello_ack", "activated", "accepted", "session_closed", "shutdown_ack"]},
    "payload": {
      "type": "object",
      "maxProperties": 128,
      "not": {"anyOf": [
        {"required": ["credential"]},
        {"required": ["password"]},
        {"required": ["secret"]},
        {"required": ["raw_path"]},
        {"required": ["cwd"]}
      ]}
    },
    "error": {
      "type": "object",
      "required": ["code", "safe_message", "retryable"],
      "properties": {
        "code": {"type": "string", "pattern": "^[a-z0-9_]{1,64}$"},
        "safe_message": {"type": "string", "minLength": 1, "maxLength": 256},
        "retryable": {"type": "boolean"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "allOf": [
    {"if": {"properties": {"ok": {"const": true}}}, "then": {"required": ["event", "payload"], "not": {"required": ["error"]}}},
    {"if": {"properties": {"ok": {"const": false}}}, "then": {"required": ["error"], "not": {"anyOf": [{"required": ["event"]}, {"required": ["payload"]}]}}}
  ]
}
