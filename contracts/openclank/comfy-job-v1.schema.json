{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openclank.local/contracts/comfy-job-v1.schema.json",
  "$comment": "Closed presentation DTO only. Authentication, owner, resource and provider authority are server-resolved; byte, depth, finite numeric bounds, min <= max and canonical digest limits are enforced by the route.",
  "$defs": {
    "token": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16384
    },
    "parameters": {
      "type": "object",
      "maxProperties": 32,
      "propertyNames": {
        "minLength": 1,
        "maxLength": 128
      },
      "additionalProperties": {
        "oneOf": [
          {
            "type": "string",
            "maxLength": 16384
          },
          {
            "type": "number"
          },
          {
            "type": "boolean"
          }
        ]
      }
    },
    "state": {
      "enum": [
        "prepared",
        "submitting",
        "queued",
        "running",
        "collecting",
        "stopping",
        "complete",
        "failed",
        "cancel_requested",
        "cancelled",
        "unknown_outcome",
        "reconciling"
      ]
    },
    "inspect": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sessionID",
        "recipeRef"
      ],
      "properties": {
        "sessionID": {
          "$ref": "#/$defs/token"
        },
        "recipeRef": {
          "$ref": "#/$defs/ref"
        }
      }
    },
    "prepare": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sessionID",
        "connectionID",
        "recipeRef",
        "destinationRef",
        "destinationName",
        "parameters"
      ],
      "properties": {
        "sessionID": {
          "$ref": "#/$defs/token"
        },
        "connectionID": {
          "$ref": "#/$defs/token"
        },
        "recipeRef": {
          "$ref": "#/$defs/ref"
        },
        "destinationRef": {
          "$ref": "#/$defs/ref"
        },
        "destinationName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "parameters": {
          "$ref": "#/$defs/parameters"
        },
        "outputProfile": {
          "enum": [
            "png",
            "flac"
          ]
        }
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "jobID",
        "revision",
        "parameters"
      ],
      "properties": {
        "jobID": {
          "$ref": "#/$defs/token"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "parameters": {
          "$ref": "#/$defs/parameters"
        }
      }
    },
    "recoveryPreview": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "jobID",
        "destinationRef",
        "destinationName"
      ],
      "properties": {
        "jobID": {
          "$ref": "#/$defs/token"
        },
        "destinationRef": {
          "$ref": "#/$defs/ref"
        },
        "destinationName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        }
      }
    },
    "recoveryPrepared": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "jobID",
        "revision",
        "recoveryID",
        "destination",
        "artifact"
      ],
      "properties": {
        "jobID": {
          "$ref": "#/$defs/token"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "recoveryID": {
          "$ref": "#/$defs/token"
        },
        "destination": {
          "$ref": "#/$defs/destination"
        },
        "artifact": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sha256",
            "size"
          ],
          "properties": {
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "size": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    },
    "recoverySave": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "jobID",
        "revision",
        "recoveryID"
      ],
      "properties": {
        "jobID": {
          "$ref": "#/$defs/token"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "recoveryID": {
          "$ref": "#/$defs/token"
        }
      }
    },
    "jobRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "jobID"
      ],
      "properties": {
        "jobID": {
          "$ref": "#/$defs/token"
        }
      }
    },
    "slot": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "type"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "type": {
              "enum": [
                "string",
                "boolean"
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "type",
            "min",
            "max"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "type": {
              "const": "integer"
            },
            "min": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "max": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "type",
            "min",
            "max"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "type": {
              "const": "number"
            },
            "min": {
              "type": "number"
            },
            "max": {
              "type": "number"
            }
          }
        }
      ]
    },
    "recipe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "sha256",
        "nodeClasses",
        "slots"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "nodeClasses": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "slots": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/slot"
          }
        }
      }
    },
    "inspected": {
      "$ref": "#/$defs/recipe"
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "connectionID",
        "connectionRevision",
        "interface"
      ],
      "properties": {
        "connectionID": {
          "$ref": "#/$defs/token"
        },
        "connectionRevision": {
          "type": "integer",
          "minimum": 1
        },
        "interface": {
          "const": "comfyui-workflow-v1"
        }
      }
    },
    "destination": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "folder"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "folder": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        }
      }
    },
    "prepared": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "jobID",
        "revision",
        "state",
        "profile",
        "destination",
        "recipe",
        "parameters"
      ],
      "properties": {
        "jobID": {
          "$ref": "#/$defs/token"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "state": {
          "const": "prepared"
        },
        "profile": {
          "$ref": "#/$defs/profile"
        },
        "destination": {
          "$ref": "#/$defs/destination"
        },
        "recipe": {
          "$ref": "#/$defs/recipe"
        },
        "parameters": {
          "$ref": "#/$defs/parameters"
        },
        "outputProfile": {
          "const": "flac"
        }
      }
    },
    "meshyRefineParameters": {"type":"object","additionalProperties":false,"required":["enablePBR"],"properties":{"enablePBR":{"type":"boolean"}}},
    "meshyRefinePrepare": {"type":"object","additionalProperties":false,"required":["sessionID","sourceJobID","destinationRef","destinationName","parameters"],"properties":{"sessionID":{"$ref":"#/$defs/token"},"sourceJobID":{"$ref":"#/$defs/token"},"destinationRef":{"$ref":"#/$defs/ref"},"destinationName":{"type":"string","minLength":1,"maxLength":255},"parameters":{"$ref":"#/$defs/meshyRefineParameters"}}},
    "meshyRefinePrepared": {"type":"object","additionalProperties":false,"required":["jobID","revision","state","profile","source","destination","parameters","notice"],"properties":{"jobID":{"$ref":"#/$defs/token"},"revision":{"type":"integer","minimum":1},"state":{"const":"prepared"},"profile":{"type":"object","additionalProperties":false,"required":["connectionID","connectionRevision","providerAccountID","providerAccountRevision","credentialVersion","interface"],"properties":{"connectionID":{"$ref":"#/$defs/token"},"connectionRevision":{"type":"integer","minimum":1},"providerAccountID":{"$ref":"#/$defs/token"},"providerAccountRevision":{"type":"integer","minimum":1},"credentialVersion":{"type":"integer","minimum":1},"interface":{"const":"meshy-preview-v1"}}},"source":{"type":"object","additionalProperties":false,"required":["jobID","sha256"],"properties":{"jobID":{"$ref":"#/$defs/token"},"sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"}}},"destination":{"type":"object","additionalProperties":false,"required":["name","folder"],"properties":{"name":{"type":"string","minLength":1,"maxLength":255},"folder":{"type":"string","maxLength":4096}}},"parameters":{"$ref":"#/$defs/meshyRefineParameters"},"notice":{"type":"string","maxLength":1024}}},
    "animationMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "animationID",
        "type",
        "frameCount",
        "fps",
        "width",
        "height",
        "sha256"
      ],
      "properties": {
        "animationID": {
          "type": "string",
          "pattern": "^anim_[A-Za-z0-9_-]{1,124}$"
        },
        "type": {
          "enum": [
            "idle",
            "walk",
            "run",
            "attack",
            "jump",
            "death",
            "hurt"
          ]
        },
        "frameCount": {
          "type": "integer",
          "minimum": 2,
          "maximum": 12
        },
        "fps": {
          "type": "integer",
          "minimum": 4,
          "maximum": 60
        },
        "width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096
        },
        "height": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
