    "jobResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "jobID",
        "revision",
        "state",
        "cancelAvailable"
      ],
      "properties": {
        "audioChoices": { "$ref": "#/$defs/recordingAudioChoices" },
        "audioSelection": { "$ref": "#/$defs/recordingAudioSelection" },
        "audioTracks": { "$ref": "#/$defs/recordingAudioTracks" },
        "recordingObservations": { "$ref": "#/$defs/recordingObservations" },
        "trimTiming": { "$ref": "#/$defs/trimTiming" },
