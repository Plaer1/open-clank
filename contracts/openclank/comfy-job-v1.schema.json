        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "state": {
          "$ref": "#/$defs/state"
        },
        "reason": {
          "enum": [
            "unavailable",
            "stale",
            "unsupported",
            "unknown",
            "files_receipt",
            "not_dispatched"
          ]
        },
        "result": {
          "$ref": "#/$defs/filesReceipt"
        }
      }
    },
