        "stopAvailable": { "type": "boolean" },
        "stopState": { "enum": [null, "issued", "accepted", "unknown"] },
        "partialAvailable": { "type": "boolean" },
        "audio": { "enum": ["unavailable", "selecting", "selected", "off"] },
        "partialRecovery": {
          "oneOf": [
            { "type": "null" },
            { "type": "object", "additionalProperties": false, "required": ["recoveryID", "state"],
              "properties": { "recoveryID": { "$ref": "#/$defs/token" },
                "state": { "enum": ["prepared", "dispatched", "unknown", "complete"] } } }
