    "fourHeadingLayout": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "coordinateFrame",
        "cellWidth",
        "cellHeight",
        "sheetWidth",
        "sheetHeight",
        "views",
        "sha256"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "coordinateFrame": {
          "const": "imported-world-z"
        },
        "cellWidth": {
          "const": 512
        },
        "cellHeight": {
          "const": 512
        },
        "sheetWidth": {
          "const": 1024
        },
        "sheetHeight": {
          "const": 1024
        },
        "views": {
          "const": [
            {
              "degrees": 0,
              "x": 0,
              "y": 0,
              "width": 512,
              "height": 512
            },
            {
              "degrees": 90,
              "x": 512,
              "y": 0,
              "width": 512,
              "height": 512
            },
            {
              "degrees": 180,
              "x": 0,
              "y": 512,
              "width": 512,
              "height": 512
            },
            {
              "degrees": 270,
              "x": 512,
              "y": 512,
              "width": 512,
              "height": 512
            }
          ]
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "filesReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operationID",
        "itemID",
        "resourceRef",
        "sha256",
        "mimeType"
      ],
      "properties": {
        "operationID": {
          "$ref": "#/$defs/token"
        },
        "itemID": {
          "const": "output"
        },
        "resourceRef": {
          "$ref": "#/$defs/ref"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "mimeType": {
          "enum": [
            "image/png",
            "model/gltf-binary",
            "audio/flac",
            "video/webm"
          ]
        },
        "animation": {
          "$ref": "#/$defs/animationMetadata"
        },
        "layout": {
          "oneOf": [{"$ref":"#/$defs/fourHeadingLayout"},{"$ref":"#/$defs/selectedSpriteLayout"}]
        },
        "audio": {
          "$ref": "#/$defs/flacHeader"
        }
      }
    },
    "trimTiming": {
      "type": "object", "additionalProperties": false, "required": ["requested", "observed"],
      "properties": {
        "requested": { "type": "object", "additionalProperties": false, "required": ["start_ms", "end_ms", "timebase"],
          "properties": { "start_ms": { "type": "integer", "minimum": 0 }, "end_ms": { "type": "integer", "minimum": 1 }, "timebase": { "const": "playback_hint" } } },
        "observed": { "type": "object", "additionalProperties": false,
