{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openclank.dev/contracts/driver-credential-callback-v1.schema.json",
  "title": "Open Clank one-shot driver credential callback v1",
  "oneOf": [
    {"$ref": "#/$defs/request"},
    {"$ref": "#/$defs/success"},
    {"$ref": "#/$defs/failure"}
  ],
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 128},
    "hex32": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
    "request": {
      "type": "object",
      "required": ["schema_version", "request_id", "lease_id", "owner_subject_id", "runtime_id", "runtime_epoch", "runtime_generation", "driver_pid", "driver_start_token", "operation", "request_sha256"],
      "properties": {
        "schema_version": {"const": 1},
        "request_id": {"$ref": "#/$defs/hex32"},
        "lease_id": {"$ref": "#/$defs/id"},
        "owner_subject_id": {"$ref": "#/$defs/id"},
        "runtime_id": {"$ref": "#/$defs/id"},
        "runtime_epoch": {"$ref": "#/$defs/hex32"},
        "runtime_generation": {"type": "integer", "minimum": 0},
        "driver_pid": {"type": "integer", "minimum": 1},
        "driver_start_token": {"$ref": "#/$defs/id"},
        "operation": {"type": "string", "pattern": "^[a-z0-9_.:-]{1,128}$"},
        "request_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    },
    "success": {
      "type": "object",
      "required": ["schema_version", "request_id", "lease_id", "ok", "credential_encoding", "credential_json_base64url", "expires_unix_ms", "uses_remaining", "request_sha256"],
      "properties": {
        "schema_version": {"const": 1},
        "request_id": {"$ref": "#/$defs/hex32"},
        "lease_id": {"$ref": "#/$defs/id"},
        "ok": {"const": true},
        "credential_encoding": {"const": "canonical-json-utf8-base64url-nopad"},
        "credential_json_base64url": {"type": "string", "pattern": "^[A-Za-z0-9_-]+$", "maxLength": 64000},
        "expires_unix_ms": {"type": "integer", "minimum": 0},
        "uses_remaining": {"const": 1},
        "request_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    },
    "failure": {
      "type": "object",
      "required": ["schema_version", "request_id", "lease_id", "ok", "error", "request_sha256"],
      "properties": {
        "schema_version": {"const": 1},
        "request_id": {"$ref": "#/$defs/hex32"},
        "lease_id": {"$ref": "#/$defs/id"},
        "ok": {"const": false},
        "error": {
          "type": "object",
          "required": ["code", "safe_message", "retryable"],
          "properties": {
            "code": {"type": "string", "pattern": "^[a-z0-9_]{1,64}$"},
            "safe_message": {"type": "string", "minLength": 1, "maxLength": 256},
            "retryable": {"type": "boolean"}
          },
          "additionalProperties": false
        },
        "request_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    }
  }
}
