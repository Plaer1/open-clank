          "additionalProperties": false
        },
        "modelFingerprint": { "type": "string", "minLength": 1, "maxLength": 256 },
        "dimension": { "type": "integer", "minimum": 1 },
        "replayed": { "type": "boolean" }
      },
      "additionalProperties": false
    }
