      "additionalProperties": false
    },
    "operationExecuteResult": {
      "type": "object",
      "required": [
        "operationID", "rootOperationID", "operation", "modelRouteID", "connectionID",
        "billingLane", "state", "committed", "output", "artifacts", "replayed"
      ],
      "properties": {
        "operationID": { "type": "string", "minLength": 1 },
        "rootOperationID": { "type": "string", "minLength": 1 },
        "operation": { "$ref": "#/$defs/operation" },
        "modelRouteID": { "type": "string", "minLength": 1 },
        "connectionID": { "type": "string", "minLength": 1 },
        "billingLane": { "$ref": "#/$defs/billingLane" },
        "state": { "enum": ["complete", "failed", "cancelled"] },
        "committed": { "type": "boolean" },
        "commitReason": { "type": "string", "minLength": 1, "maxLength": 128 },
        "bindingID": { "type": "string", "minLength": 1 },
        "selectedAccountID": { "type": "string", "minLength": 1 },
        "output": { "type": "object" },
        "artifacts": { "type": "array", "items": { "$ref": "#/$defs/artifactDescriptor" } },
        "usage": {
          "type": "object",
          "properties": {
            "inputTokens": { "type": "integer", "minimum": 0 },
            "outputTokens": { "type": "integer", "minimum": 0 },
            "totalTokens": { "type": "integer", "minimum": 0 }
