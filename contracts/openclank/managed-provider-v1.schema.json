            "action", "rootOperationID", "operation", "idempotencyKey", "request",
            "connectionID", "billingLane", "modelRouteID"
          ],
          "properties": {
            "action": { "const": "begin" },
            "rootOperationID": { "type": "string", "minLength": 1 },
            "operation": { "$ref": "#/$defs/operation" },
            "idempotencyKey": { "type": "string", "minLength": 16, "maxLength": 128 },
            "request": { "type": "object" },
            "connectionID": { "type": "string", "minLength": 1 },
            "billingLane": { "$ref": "#/$defs/billingLane" },
            "modelRouteID": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["action", "operationID", "expectedRevision"],
          "properties": {
            "action": { "const": "cas" },
            "operationID": { "type": "string", "minLength": 1 },
            "expectedRevision": { "type": "integer", "minimum": 1 },
            "state": { "enum": ["pending", "running", "complete", "failed", "cancelled"] },
