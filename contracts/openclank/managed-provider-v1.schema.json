            "selectedAccountID": { "type": "string", "minLength": 1 },
            "attempt": { "type": "object" },
            "commitReason": { "type": "string", "minLength": 1, "maxLength": 128 },
            "artifactID": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        }
      ]
    },
    "operationJournalResult": {
      "type": "object",
      "required": [
        "operationID", "rootOperationID", "operation", "requestHash", "connectionID",
        "billingLane", "modelRouteID", "state", "committed", "attempts", "artifactIDs",
        "revision", "replayed"
      ],
      "properties": {
        "operationID": { "type": "string", "minLength": 1 },
        "rootOperationID": { "type": "string", "minLength": 1 },
        "operation": { "$ref": "#/$defs/operation" },
