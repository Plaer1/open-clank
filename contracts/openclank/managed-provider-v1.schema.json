      "type": "object",
      "required": [
        "artifactID", "contentSHA256", "sizeBytes", "mediaType", "offset",
        "dataBase64", "chunkSHA256", "eof"
      ],
      "properties": {
        "artifactID": { "type": "string", "minLength": 1 },
        "contentSHA256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
