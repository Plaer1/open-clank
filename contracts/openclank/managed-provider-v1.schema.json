        "operation": { "$ref": "#/$defs/operation" },
        "routes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": { "$ref": "#/$defs/operationRouteContext" }
        },
        "input": { "type": "object" },
        "artifactInputs": {
          "type": "array",
          "maxItems": 64,
          "items": { "$ref": "#/$defs/operationArtifactInput" }
        },
        "options": { "type": "object" }
