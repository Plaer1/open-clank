        "eof": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "artifactWriteRequest": {
      "oneOf": [
        {
          "type": "object",
          "required": ["action", "mediaType", "contentSHA256", "sizeBytes", "chunks"],
          "properties": {
            "action": { "const": "put" },
            "mediaType": { "type": "string", "minLength": 1, "maxLength": 255 },
            "contentSHA256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
            "sizeBytes": { "type": "integer", "minimum": 0, "maximum": 268435456 },
            "chunks": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["index", "dataBase64", "sha256"],
                "properties": {
                  "index": { "type": "integer", "minimum": 0 },
                  "dataBase64": { "type": "string" },
                  "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
                },
                "additionalProperties": false
              }
            }
          },
          "allOf": [
            {
              "if": { "properties": { "sizeBytes": { "const": 0 } }, "required": ["sizeBytes"] },
              "then": { "properties": { "chunks": { "maxItems": 0 } } },
              "else": { "properties": { "chunks": { "minItems": 1 } } }
            }
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["action", "artifactID"],
          "properties": {
            "action": { "const": "acknowledge" },
            "artifactID": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        }
      ]
    },
